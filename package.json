{
  "name": "kafka-delivery-tracking",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm --prefix server ci && npm --prefix client ci",
    "infra": "docker compose up -d --wait",
    "dev": "node server/scripts/dev.js --client",
    "demo": "node server/scripts/dev.js --client --demo",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "test:integration": "npm --prefix server run test:integration",
    "test:browser": "node --test tests/browser.test.mjs",
    "format": "prettier --write client/src server/{server.js,api,auth,config,consumer,kafka,lib,producer,realtime,scripts,storage} README.md"
  },


  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "prettier": "^3.9.9"
  }
}
