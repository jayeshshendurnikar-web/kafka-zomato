PORT=5000
HOST=127.0.0.1
KAFKA_BROKERS=localhost:19092
REDIS_URL=redis://127.0.0.1:16379
MONGODB_URI=mongodb://127.0.0.1:27017/kafka_zomato
ACTIVITY_LOGS=true
KAFKA_LOCATION_TOPIC=rider.locations.v1
KAFKA_LOCATION_GROUP=location-cache-v1
KAFKA_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
LOCATION_MIN_INTERVAL_MS=3000
LOCATION_TTL_SECONDS=86400
LOCATION_MAX_AGE_MS=300000
LOCATION_MAX_FUTURE_MS=30000
# Local demo only. For deployment use false and a random secret of 32+ characters.
DEMO_MODE=true
TRACKING_TOKEN_SECRET=
