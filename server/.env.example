# ==============================================================================
# 1. LOCAL CONFIGURATION (Use Docker for Kafka & Redis, Atlas for MongoDB)
# ==============================================================================
PORT=5000
HOST=127.0.0.1
DEMO_MODE=true
ACTIVITY_LOGS=true

# MongoDB (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/test

# Local Kafka (via docker compose on port 19092)
KAFKA_BROKERS=localhost:19092
KAFKA_LOCATION_TOPIC=rider.locations.v1
KAFKA_LOCATION_GROUP=location-cache-v1
KAFKA_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1

# Local Redis (via docker compose on port 16379)
REDIS_URL=redis://127.0.0.1:16379

# ==============================================================================
# 2. LIVE / PRODUCTION CONFIGURATION (Render / Cloud Environment Variables)
# ==============================================================================
# NODE_ENV=production
# ALLOW_PROD_DEMO=true
# DEMO_MODE=true
# PORT=5000
# HOST=0.0.0.0
# CLIENT_ORIGIN=https://kafka-zomato.vercel.app
#
# MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/test
#
# REDIS_URL=rediss://default:pass@xxxx.upstash.io:6379
#
# KAFKA_BROKERS=kafka-xxxx.aivencloud.com:11480
# KAFKA_SASL_USERNAME=avnadmin
# KAFKA_SASL_PASSWORD=your_password
# KAFKA_SASL_MECHANISM=scram-sha-256
